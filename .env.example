APP_NAME="RAG Backend"
APP_VERSION="0.1.0"
APP_DEBUG=false
API_V1_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://postgres:postgres@127.0.0.1:5433/rag_backend"
MAX_UPLOAD_SIZE_MB=10
RECURSIVE_CHUNK_SIZE=1500
RECURSIVE_CHUNK_OVERLAP=200
SEMANTIC_BREAKPOINT_PERCENTILE=80
SEMANTIC_MIN_CHUNK_SIZE=400
SEMANTIC_MAX_CHUNK_SIZE=1500
OLLAMA_URL="http://127.0.0.1:11434"
EMBEDDING_MODEL="embeddinggemma"
EMBEDDING_BATCH_SIZE=32
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_COLLECTION="document_chunks"
